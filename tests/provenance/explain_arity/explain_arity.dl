//
// explain_arity.dl
// The explain interface reports tuples with the wrong number of arguments,
// rather than reading past the end of the tuple (which could crash or
// explain a tuple that does not exist).
//

.pragma "provenance" "explain"

.decl edge(x: number, y: number)
edge(1, 2).
edge(2, 3).

.decl path(x: number, y: number)
path(x, y) :- edge(x, y).
path(x, z) :- edge(x, y), path(y, z).

.decl named(n: symbol, x: number)
named(n, x) :- edge(x, _), n = to_string(x).

.output path, named
